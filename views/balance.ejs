<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Balance Financiero - Gimnasio La Fabrica</title>
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="container-fluid">
        <div class="row">
            <%- include('partials/sidebar') %>
            <main class="col-md-10 ms-sm-auto px-md-4 main-content">
                <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h1><i class="fas fa-scale-balanced me-2"></i>Balance Financiero</h1>
                        <p class="text-muted mb-0 small">Comparativa de ingresos de caja, gastos operativos y cuentas por cobrar</p>
                    </div>
                </div>

                <!-- FILTRO DE FECHAS -->
                <div class="card mb-4 shadow-sm">
                    <div class="card-body">
                        <form method="GET" action="/pages/balance.php" class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Fecha Inicio:</label>
                                <input type="date" name="fecha_inicio" class="form-control" value="<%= inicio %>">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Fecha Fin:</label>
                                <input type="date" name="fecha_fin" class="form-control" value="<%= fin %>">
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-primary w-100"><i class="fas fa-calculator me-1"></i> Calcular Balance</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- RESUMEN DE BALANCE -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="stat-card border-start border-4 border-success text-start shadow-sm">
                            <small class="text-muted text-uppercase fw-bold">Ingresos Cobrados</small>
                            <h3 class="text-success my-1">+$<%= total_ingresos_cobrados.toFixed(2) %></h3>
                            <div class="small text-muted">Prod: $<%= ing_prod.toFixed(2) %> | Mem: $<%= ing_mem.toFixed(2) %> | Pases: $<%= ing_temp.toFixed(2) %></div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="stat-card border-start border-4 border-danger text-start shadow-sm">
                            <small class="text-muted text-uppercase fw-bold">Gastos Totales</small>
                            <h3 class="text-danger my-1">-$<%= gastos.toFixed(2) %></h3>
                            <div class="small text-muted">Egresos operativos del período</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="stat-card border-start border-4 <%= balance_neto >= 0 ? 'border-primary' : 'border-danger' %> text-start shadow-sm">
                            <small class="text-muted text-uppercase fw-bold">Balance Neto</small>
                            <h3 class="<%= balance_neto >= 0 ? 'text-primary' : 'text-danger' %> my-1">$<%= balance_neto.toFixed(2) %></h3>
                            <div class="small text-muted">Ingresos cobrados menos gastos</div>
                        </div>
                    </div>
                </div>

                <!-- DETALLE DE INGRESOS Y CUENTAS POR COBRAR -->
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-header bg-light fw-bold">
                                <i class="fas fa-money-bill-wave me-2"></i>Desglose de Ingresos
                            </div>
                            <div class="card-body">
                                <ul class="list-group list-group-flush">
                                    <li class="d-flex justify-content-between align-items-center py-2">
                                        <span><i class="fas fa-box text-primary me-2"></i>Venta de Productos (Tienda)</span>
                                        <span class="fw-bold">$<%= ing_prod.toFixed(2) %></span>
                                    </li>
                                    <li class="d-flex justify-content-between align-items-center py-2">
                                        <span><i class="fas fa-id-card text-success me-2"></i>Venta de Membresías y Planes</span>
                                        <span class="fw-bold">$<%= ing_mem.toFixed(2) %></span>
                                    </li>
                                    <li class="d-flex justify-content-between align-items-center py-2">
                                        <span><i class="fas fa-ticket-alt text-warning me-2"></i>Pases Diarios y Visitas</span>
                                        <span class="fw-bold">$<%= ing_temp.toFixed(2) %></span>
                                    </li>
                                    <li class="d-flex justify-content-between align-items-center py-2 border-top fw-bold">
                                        <span>Total Cobrado en Período:</span>
                                        <span class="text-success">$<%= total_ingresos_cobrados.toFixed(2) %></span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-header bg-light fw-bold">
                                <i class="fas fa-hand-holding-dollar me-2"></i>Créditos Otorgados y Deudas
                            </div>
                            <div class="card-body">
                                <ul class="list-group list-group-flush">
                                    <li class="d-flex justify-content-between align-items-center py-2">
                                        <span>Crédito Otorgado en Período:</span>
                                        <span class="fw-bold text-dark">$<%= credito_otorgado.toFixed(2) %></span>
                                    </li>
                                    <li class="d-flex justify-content-between align-items-center py-2">
                                        <span>Abonos Recibidos:</span>
                                        <span class="fw-bold text-success">$<%= credito_abonado.toFixed(2) %></span>
                                    </li>
                                    <li class="d-flex justify-content-between align-items-center py-2 border-top">
                                        <span>Saldo Pendiente por Cobrar:</span>
                                        <span class="fw-bold text-danger">$<%= deudas_pendientes.toFixed(2) %></span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <script src="/js/bootstrap.bundle.min.js"></script>
</body>
</html>
