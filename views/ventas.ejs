<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Punto de Venta - Gimnasio La Fábrica</title>
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="container-fluid">
        <div class="row">
            <%- include('partials/sidebar') %>
            <main class="col-md-10 ms-sm-auto px-md-4 main-content">
                <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h1><i class="fas fa-shopping-cart me-2"></i>Punto de Venta</h1>
                        <p class="text-muted mb-0 small">Venta de productos internos y externos, soporte para compras a crédito y tickets</p>
                    </div>
                    <a href="/pages/historial_ventas.php" class="btn btn-outline-secondary">
                        <i class="fas fa-receipt me-1"></i> Historial de Ventas
                    </a>
                </div>

                <% if (mensaje) { %>
                    <div class="alert alert-<%= tipo_mensaje %> alert-dismissible fade show">
                        <%- mensaje %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <div class="row g-4">
                    <!-- Catálogo de Productos -->
                    <div class="col-lg-7">
                        <div class="card shadow-sm h-100">
                            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                                <span><i class="fas fa-boxes me-2"></i>Catálogo de Productos</span>
                                <span class="badge bg-light text-primary"><%= productos.length %> disponibles</span>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="fas fa-search text-muted"></i></span>
                                        <input type="text" id="filtroProducto" class="form-control" placeholder="Buscar por nombre o código de barras..." onkeyup="filtrarCatalogo()">
                                    </div>
                                </div>

                                <div class="row g-3" id="catalogoGrid">
                                    <% productos.forEach(function(p) { %>
                                    <div class="col-md-6 item-producto" data-nombre="<%= p.name.toLowerCase() %>" data-codigo="<%= (p.barcode || '').toLowerCase() %>">
                                        <div class="card h-100 border p-3 cursor-pointer shadow-sm hover-shadow" onclick="agregarAlCarrito(<%= JSON.stringify(p).replace(/"/g, '&quot;') %>)">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <h6 class="fw-bold mb-0 text-dark"><%= p.name %></h6>
                                                <span class="badge <%= p.isExternal ? 'bg-info text-dark' : 'bg-primary' %>">
                                                    <%= p.isExternal ? 'Externo' : 'Interno' %>
                                                </span>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                                <div class="fs-5 fw-bold text-success">$<%= p.salePrice.toFixed(2) %></div>
                                                <small class="text-muted">Existencias: <strong class="<%= p.quantity <= p.minStock ? 'text-danger' : 'text-dark' %>"><%= p.quantity %> uds.</strong></small>
                                            </div>
                                        </div>
                                    </div>
                                    <% }); %>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Carrito de Compras & Cobro -->
                    <div class="col-lg-5">
                        <div class="card shadow-sm h-100 border-primary">
                            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                                <span><i class="fas fa-cash-register me-2"></i>Orden de Venta</span>
                                <button type="button" class="btn btn-sm btn-outline-light" onclick="vaciarCarrito()">Limpiar</button>
                            </div>
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div class="table-responsive mb-3" style="max-height: 280px; overflow-y: auto;">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead class="table-light">
                                            <tr><th>Producto</th><th class="text-center">Cant.</th><th class="text-end">Subtotal</th><th></th></tr>
                                        </thead>
                                        <tbody id="carritoTbody">
                                            <tr><td colspan="4" class="text-center py-4 text-muted">El carrito está vacío. Haz clic en un producto para agregarlo.</td></tr>
                                        </tbody>
                                    </table>
                                </div>

                                <div class="border-top pt-3">
                                    <div class="d-flex justify-content-between mb-1 text-muted small">
                                        <span>Subtotal Interno:</span>
                                        <span id="txtSubInterno">$0.00</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2 text-muted small">
                                        <span>Subtotal Externo:</span>
                                        <span id="txtSubExterno">$0.00</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-3 border-top pt-2">
                                        <span class="fs-5 fw-bold">Total a Cobrar:</span>
                                        <span class="fs-4 fw-bold text-success" id="txtTotalGlobal">$0.00</span>
                                    </div>

                                    <form method="POST" action="/pages/ventas.php" id="formVenta" onsubmit="return procesarVenta(event)">
                                        <input type="hidden" name="accion" value="crear_venta">
                                        <input type="hidden" name="items" id="inputItems" value="[]">

                                        <div class="mb-3">
                                            <label class="form-label fw-bold small">Método de Pago:</label>
                                            <select name="paymentMethod" id="paymentMethod" class="form-select" onchange="cambioMetodoPago()">
                                                <option value="efectivo">Efectivo</option>
                                                <option value="tarjeta">Tarjeta (Terminal)</option>
                                                <option value="transferencia">Transferencia Bancaria</option>
                                                <option value="credito">A Crédito (Deuda de Socio)</option>
                                            </select>
                                        </div>

                                        <div class="mb-3" id="seccionCliente">
                                            <label class="form-label fw-bold small">Socio / Cliente:</label>
                                            <select name="clientId" id="clientId" class="form-select">
                                                <option value="">Público General (Sin socio)</option>
                                                <% clientes.forEach(function(c) { %>
                                                    <option value="<%= c.id %>"><%= c.fullName %> (<%= c.phone || 'S/N' %>)</option>
                                                <% }); %>
                                            </select>
                                        </div>

                                        <button type="submit" class="btn btn-success w-100 py-2 fw-bold fs-5" id="btnCobrar" disabled>
                                            <i class="fas fa-check-circle me-1"></i> Cobrar e Imprimir Ticket
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script>
        let carrito = [];

        function filtrarCatalogo() {
            const txt = document.getElementById('filtroProducto').value.toLowerCase().trim();
            document.querySelectorAll('.item-producto').forEach(el => {
                const nombre = el.getAttribute('data-nombre');
                const codigo = el.getAttribute('data-codigo');
                if (!txt || nombre.includes(txt) || codigo.includes(txt)) {
                    el.style.display = '';
                } else {
                    el.style.display = 'none';
                }
            });
        }

        function agregarAlCarrito(prod) {
            const idx = carrito.findIndex(i => i.productId === prod.id);
            if (idx >= 0) {
                if (carrito[idx].quantity >= prod.quantity) {
                    alert('Existencia máxima alcanzada para ' + prod.name);
                    return;
                }
                carrito[idx].quantity += 1;
                carrito[idx].subtotal = carrito[idx].quantity * carrito[idx].unitPrice;
            } else {
                if (prod.quantity < 1) {
                    alert('Producto sin existencia disponible.');
                    return;
                }
                carrito.push({
                    productId: prod.id,
                    productName: prod.name,
                    unitPrice: Number(prod.salePrice),
                    quantity: 1,
                    subtotal: Number(prod.salePrice),
                    isExternal: prod.isExternal ? 1 : 0
                });
            }
            renderCarrito();
        }

        function cambiarCantidad(idx, delta) {
            carrito[idx].quantity += delta;
            if (carrito[idx].quantity <= 0) {
                carrito.splice(idx, 1);
            } else {
                carrito[idx].subtotal = carrito[idx].quantity * carrito[idx].unitPrice;
            }
            renderCarrito();
        }

        function eliminarItem(idx) {
            carrito.splice(idx, 1);
            renderCarrito();
        }

        function vaciarCarrito() {
            carrito = [];
            renderCarrito();
        }

        function renderCarrito() {
            const tbody = document.getElementById('carritoTbody');
            let subInt = 0, subExt = 0;

            if (carrito.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-muted">El carrito está vacío. Haz clic en un producto para agregarlo.</td></tr>';
                document.getElementById('btnCobrar').disabled = true;
            } else {
                let html = '';
                carrito.forEach((it, idx) => {
                    if (it.isExternal) subExt += it.subtotal;
                    else subInt += it.subtotal;
                    html += `
                        <tr>
                            <td>
                                <strong class="small">${it.productName}</strong>
                                <div class="text-muted" style="font-size: 0.75rem;">$${it.unitPrice.toFixed(2)} c/u</div>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-secondary py-0 px-2" onclick="cambiarCantidad(${idx}, -1)">-</button>
                                    <span class="px-2 fw-bold">${it.quantity}</span>
                                    <button type="button" class="btn btn-outline-secondary py-0 px-2" onclick="cambiarCantidad(${idx}, 1)">+</button>
                                </div>
                            </td>
                            <td class="text-end fw-bold">$${it.subtotal.toFixed(2)}</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm text-danger p-0" onclick="eliminarItem(${idx})"><i class="fas fa-times"></i></button>
                            </td>
                        </tr>
                    `;
                });
                tbody.innerHTML = html;
                document.getElementById('btnCobrar').disabled = false;
            }

            document.getElementById('txtSubInterno').innerText = '$' + subInt.toFixed(2);
            document.getElementById('txtSubExterno').innerText = '$' + subExt.toFixed(2);
            document.getElementById('txtTotalGlobal').innerText = '$' + (subInt + subExt).toFixed(2);
            document.getElementById('inputItems').value = JSON.stringify(carrito);
        }

        function cambioMetodoPago() {
            const m = document.getElementById('paymentMethod').value;
            const cSelect = document.getElementById('clientId');
            if (m === 'credito') {
                cSelect.required = true;
                if (!cSelect.value) {
                    alert('Para ventas a crédito, selecciona al socio que asumirá la deuda.');
                }
            } else {
                cSelect.required = false;
            }
        }

        function procesarVenta(e) {
            const m = document.getElementById('paymentMethod').value;
            const cid = document.getElementById('clientId').value;
            if (m === 'credito' && !cid) {
                alert('Debes seleccionar un socio registrado para fiar la compra a crédito.');
                e.preventDefault();
                return false;
            }
            return true;
        }
    </script>
</body>
</html>
