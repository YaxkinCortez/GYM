<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clientes y Socios - Gimnasio La Fabrica</title>
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="container-fluid">
        <div class="row">
            <%- include('partials/sidebar') %>
            <main class="col-md-10 ms-sm-auto px-md-4 main-content">
                <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h1><i class="fas fa-users me-2"></i>Gestión de Clientes y Socios</h1>
                        <p class="text-muted mb-0 small">Catálogo general, fichas completas, membresías y adeudos</p>
                    </div>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevoCliente">
                        <i class="fas fa-user-plus me-1"></i> Registrar Socio
                    </button>
                </div>

                <% if (mensaje) { %>
                    <div class="alert alert-<%= tipo_mensaje %> alert-dismissible fade show">
                        <%- mensaje %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <!-- Buscador de socios -->
                <div class="card mb-3 shadow-sm">
                    <div class="card-body py-2">
                        <form method="GET" action="/pages/clientes.php" class="row g-2 align-items-center">
                            <div class="col-md-8">
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-search text-muted"></i></span>
                                    <input type="text" name="q" value="<%= q || '' %>" class="form-control" placeholder="Buscar por nombre, teléfono o código huella...">
                                </div>
                            </div>
                            <div class="col-md-4 d-flex gap-2">
                                <button type="submit" class="btn btn-secondary w-100"><i class="fas fa-filter me-1"></i> Filtrar</button>
                                <% if (q) { %>
                                    <a href="/pages/clientes.php" class="btn btn-outline-secondary">Limpiar</a>
                                <% } %>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Tabla de Socios -->
                <div class="card shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Nombre Completo</th>
                                    <th>Teléfono</th>
                                    <th>Huella</th>
                                    <th>Membresía Actual</th>
                                    <th>Deuda</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (clientes.length === 0) { %>
                                    <tr><td colspan="7" class="text-center py-4 text-muted">No se encontraron clientes registrados.</td></tr>
                                <% } else { %>
                                    <% clientes.forEach(function(c) { %>
                                    <tr>
                                        <td><span class="badge bg-light text-dark border">#<%= c.id %></span></td>
                                        <td class="fw-bold">
                                            <%= c.fullName %>
                                            <% if (c.deudaTotal > 0) { %>
                                                <span class="badge bg-danger ms-1" title="Tiene adeudo pendiente">Deuda</span>
                                            <% } %>
                                        </td>
                                        <td><%= c.phone || 'S/N' %></td>
                                        <td><code><%= c.fingerprint || 'Sin huella' %></code></td>
                                        <td>
                                            <% if (c.membresiaActual) { %>
                                                <div>
                                                    <span class="badge <%= c.membresiaEstadoClase %>"><%= c.membresiaActual.membership_name %></span>
                                                    <small class="d-block text-muted">Hasta <%= F(c.membresiaActual.endDate) %> (<%= c.diasRestantes %> días)</small>
                                                </div>
                                            <% } else { %>
                                                <span class="badge bg-secondary">Sin membresía</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (c.deudaTotal > 0) { %>
                                                <span class="text-danger fw-bold">$<%= c.deudaTotal.toFixed(2) %></span>
                                            <% } else { %>
                                                <span class="text-success small"><i class="fas fa-check-circle"></i> Al corriente</span>
                                            <% } %>
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-info" title="Ficha completa del socio" onclick="abrirFicha(<%= c.id %>)">
                                                    <i class="fas fa-id-card"></i> Ficha
                                                </button>
                                                <button class="btn btn-outline-success" title="Renovar / Asignar Membresía" onclick="abrirRenovacion(<%= c.id %>, '<%= c.fullName.replace(/'/g, "\\'") %>')">
                                                    <i class="fas fa-calendar-plus"></i> Membresía
                                                </button>
                                                <button class="btn btn-outline-primary" title="Editar datos" onclick="abrirEdicion(<%= JSON.stringify(c).replace(/"/g, '&quot;') %>)">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <form method="POST" action="/pages/clientes.php" class="d-inline m-0" onsubmit="return confirm('¿Eliminar al cliente <%= c.fullName.replace(/'/g, "\\'") %>?');">
                                                    <input type="hidden" name="accion" value="eliminar">
                                                    <input type="hidden" name="id" value="<%= c.id %>">
                                                    <button type="submit" class="btn btn-outline-danger" title="Eliminar">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- MODAL NUEVO CLIENTE -->
    <div class="modal fade" id="modalNuevoCliente" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="POST" action="/pages/clientes.php">
                    <input type="hidden" name="accion" value="crear">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold"><i class="fas fa-user-plus me-2"></i>Registrar Nuevo Socio</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Nombre Completo:</label>
                            <input type="text" name="fullName" class="form-control" required placeholder="Ej: Roberto Sánchez">
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Género:</label>
                                <select name="gender" class="form-select" required>
                                    <option value="masculino">Masculino</option>
                                    <option value="femenino">Femenino</option>
                                    <option value="otro">Otro</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Teléfono:</label>
                                <input type="text" name="phone" class="form-control" placeholder="555-000-0000">
                            </div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Fecha de Nacimiento:</label>
                                <input type="date" name="dateOfBirth" class="form-control">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Código Huella / Identificador:</label>
                                <input type="text" name="fingerprint" class="form-control" placeholder="Ej: FP-1024">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Dirección:</label>
                            <input type="text" name="address" class="form-control" placeholder="Calle, número, colonia...">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Guardar Socio</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL EDITAR CLIENTE -->
    <div class="modal fade" id="modalEditarCliente" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="POST" action="/pages/clientes.php">
                    <input type="hidden" name="accion" value="editar">
                    <input type="hidden" name="id" id="edit_id">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold"><i class="fas fa-edit me-2"></i>Editar Datos del Socio</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Nombre Completo:</label>
                            <input type="text" name="fullName" id="edit_fullName" class="form-control" required>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Género:</label>
                                <select name="gender" id="edit_gender" class="form-select" required>
                                    <option value="masculino">Masculino</option>
                                    <option value="femenino">Femenino</option>
                                    <option value="otro">Otro</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Teléfono:</label>
                                <input type="text" name="phone" id="edit_phone" class="form-control">
                            </div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Fecha Nacimiento:</label>
                                <input type="date" name="dateOfBirth" id="edit_dateOfBirth" class="form-control">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Huella:</label>
                                <input type="text" name="fingerprint" id="edit_fingerprint" class="form-control">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Dirección:</label>
                            <input type="text" name="address" id="edit_address" class="form-control">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL RENOVAR / ASIGNAR PLAN -->
    <div class="modal fade" id="modalPlan" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="POST" action="/pages/clientes.php">
                    <input type="hidden" name="accion" value="asignar_membresia">
                    <input type="hidden" name="clientId" id="plan_clientId">
                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title fw-bold"><i class="fas fa-calendar-check me-2"></i>Asignar / Renovar Plan</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-3">Socio: <strong id="plan_clientName"></strong></p>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Seleccionar Plan:</label>
                            <select name="membershipId" class="form-select" required>
                                <% planes.forEach(function(m) { %>
                                    <option value="<%= m.id %>"><%= m.name %> - $<%= m.cost.toFixed(2) %> (<%= m.durationDays %> días)</option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Fecha de Inicio:</label>
                            <input type="date" name="startDate" class="form-control" value="<%= hoy %>" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success"><i class="fas fa-check me-1"></i> Confirmar Membresía</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL FICHA COMPLETA -->
    <div class="modal fade" id="modalFicha" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title fw-bold"><i class="fas fa-id-card me-2"></i>Ficha Integral del Socio</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="ficha_body">
                    <div class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x text-muted"></i></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script>
        function abrirEdicion(c) {
            document.getElementById('edit_id').value = c.id;
            document.getElementById('edit_fullName').value = c.fullName;
            document.getElementById('edit_gender').value = c.gender;
            document.getElementById('edit_phone').value = c.phone || '';
            document.getElementById('edit_dateOfBirth').value = c.dateOfBirth || '';
            document.getElementById('edit_fingerprint').value = c.fingerprint || '';
            document.getElementById('edit_address').value = c.address || '';
            new bootstrap.Modal(document.getElementById('modalEditarCliente')).show();
        }

        function abrirRenovacion(id, name) {
            document.getElementById('plan_clientId').value = id;
            document.getElementById('plan_clientName').innerText = name;
            new bootstrap.Modal(document.getElementById('modalPlan')).show();
        }

        function abrirFicha(id) {
            const modalEl = document.getElementById('modalFicha');
            const bodyEl = document.getElementById('ficha_body');
            bodyEl.innerHTML = '<div class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x text-muted"></i></div>';
            new bootstrap.Modal(modalEl).show();

            fetch('/pages/clientes.php', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'accion=obtener_info_cliente&cliente_id=' + id
            })
            .then(res => res.json())
            .then(data => {
                if (data.status !== 'ok') {
                    bodyEl.innerHTML = '<div class="alert alert-danger">' + (data.message || 'Error') + '</div>';
                    return;
                }
                const c = data.cliente;
                const m = data.membresiaActual;
                let html = `
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <h4 class="fw-bold text-primary mb-1">${c.fullName}</h4>
                            <p class="text-muted small mb-1"><strong>ID:</strong> #${c.id} | <strong>Género:</strong> ${c.gender}</p>
                            <p class="text-muted small mb-1"><strong>Teléfono:</strong> ${c.phone || 'S/N'}</p>
                            <p class="text-muted small mb-1"><strong>Dirección:</strong> ${c.address || 'S/N'}</p>
                            <p class="text-muted small mb-0"><strong>Huella:</strong> <code>${c.fingerprint || 'Sin huella'}</code></p>
                        </div>
                        <div class="col-md-6 border-start ps-3">
                            <h6 class="fw-bold">Estado de Membresía:</h6>
                            ${m ? `
                                <div class="p-2 rounded bg-light border">
                                    <div class="fw-bold text-success">${m.membership_name}</div>
                                    <div class="small">Inicio: ${F(m.startDate)} | Fin: ${F(m.endDate)}</div>
                                    <div class="small fw-bold ${m.dias_restantes >= 0 ? 'text-primary' : 'text-danger'}">
                                        ${m.dias_restantes >= 0 ? m.dias_restantes + ' días restantes' : 'Caducada hace ' + Math.abs(m.dias_restantes) + ' días'}
                                    </div>
                                </div>
                            ` : '<div class="text-muted small">Sin membresía registrada.</div>'}
                            
                            <h6 class="fw-bold mt-3">Estado de Deudas:</h6>
                            ${data.totalDeudaPendiente > 0 ? `
                                <div class="text-danger fw-bold fs-5">$${Number(data.totalDeudaPendiente).toFixed(2)} pendiente</div>
                                <a href="/pages/abonos.php" class="btn btn-sm btn-outline-danger mt-1">Ir a Abonos y Liquidar</a>
                            ` : '<div class="text-success small"><i class="fas fa-check-circle"></i> Sin adeudos pendientes</div>'}
                        </div>
                    </div>
                `;
                bodyEl.innerHTML = html;
            })
            .catch(err => {
                bodyEl.innerHTML = '<div class="alert alert-danger">Error al cargar ficha del socio.</div>';
            });
        }
    </script>
</body>
</html>
