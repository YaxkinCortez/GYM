<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Actualizaciones de GitHub - Gimnasio La Fábrica</title>
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="container-fluid">
        <div class="row">
            <%- include('partials/sidebar') %>
            <main class="col-md-10 ms-sm-auto px-md-4 main-content">
                <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h1><i class="fas fa-cloud-arrow-down me-2"></i>Actualizaciones del Sistema</h1>
                        <p class="text-muted mb-0 small">Enlace con GitHub, comprobación de nuevas versiones e instalación automática segura</p>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="/descargar-proyecto-zip" class="btn btn-outline-success shadow-sm">
                            <i class="fas fa-file-zipper me-1"></i> Descargar Proyecto (.zip)
                        </a>
                        <form method="POST" action="/pages/actualizaciones.php" class="m-0">
                            <input type="hidden" name="accion" value="comprobar_ahora">
                            <button type="submit" class="btn btn-primary shadow-sm">
                                <i class="fas fa-rotate me-1"></i> Comprobar Actualizaciones en GitHub
                            </button>
                        </form>
                    </div>
                </div>

                <% if (mensaje) { %>
                    <div class="alert alert-<%= tipo_mensaje %> alert-dismissible fade show shadow-sm">
                        <%- mensaje %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <!-- TARJETA PRINCIPAL DE ESTADO DE VERSIÓN -->
                <div class="row g-4 mb-4">
                    <div class="col-lg-7">
                        <div class="card shadow-sm h-100 border-top border-4 <%= updater.actualizacionDisponible ? 'border-warning' : 'border-success' %>">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <small class="text-muted text-uppercase fw-bold">Estado de Sincronización</small>
                                        <h3 class="fw-bold my-1 text-dark">
                                            <%= updater.actualizacionDisponible ? '¡Nueva Versión Detectada!' : 'Sistema Totalmente Actualizado' %>
                                        </h3>
                                        <p class="text-muted small mb-0">
                                            Repositorio oficial vinculado: 
                                            <a href="https://github.com/<%= updater.repo %>" target="_blank" rel="noopener" class="fw-bold text-decoration-none">
                                                <i class="fab fa-github me-1"></i><%= updater.repo %>
                                            </a>
                                        </p>
                                    </div>
                                    <span class="badge <%= updater.actualizacionDisponible ? 'bg-warning text-dark' : 'bg-success' %> fs-6 px-3 py-2">
                                        <i class="fas <%= updater.actualizacionDisponible ? 'fa-bell' : 'fa-check-circle' %> me-1"></i>
                                        <%= updater.actualizacionDisponible ? 'Actualización Lista' : 'Al Día' %>
                                    </span>
                                </div>

                                <div class="row g-3 bg-light p-3 rounded border mb-3">
                                    <div class="col-sm-6">
                                        <div class="text-muted small">Versión Instalada:</div>
                                        <div class="fs-5 fw-bold text-primary"><%= updater.versionActual %></div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="text-muted small">Última Comprobación:</div>
                                        <div class="fw-bold text-dark"><%= updater.ultimaComprobacion %></div>
                                    </div>
                                </div>

                                <!-- SECCIÓN DE INSTALACIÓN INMEDIATA SI HAY ACTUALIZACIÓN DISPONIBLE -->
                                <% if (updater.actualizacionDisponible) { %>
                                    <div class="alert alert-warning border-warning d-flex align-items-center gap-3 mb-3">
                                        <i class="fas fa-download fa-2x text-warning"></i>
                                        <div class="flex-grow-1">
                                            <div class="fw-bold text-dark">Nueva Versión <%= updater.actualizacionDisponible.version %></div>
                                            <div class="small text-muted"><%= updater.actualizacionDisponible.descripcion %></div>
                                        </div>
                                    </div>

                                    <div class="d-flex flex-wrap gap-2 align-items-center">
                                        <form method="POST" action="/pages/actualizaciones.php" class="m-0 flex-grow-1" onsubmit="return confirm('¿Descargar e instalar automáticamente la versión <%= updater.actualizacionDisponible.version %>? Tu base de datos local será respaldada y preservada.');">
                                            <input type="hidden" name="accion" value="instalar_actualizacion">
                                            <button type="submit" class="btn btn-success w-100 py-2 fw-bold fs-5 shadow-sm">
                                                <i class="fas fa-cloud-arrow-down me-2"></i> Descargar e Instalar Ahora
                                            </button>
                                        </form>
                                    </div>
                                <% } else { %>
                                    <div class="alert alert-success bg-success-subtle text-success border-success small mb-0">
                                        <i class="fas fa-shield-check me-2"></i>Tu sistema cuenta con las últimas optimizaciones y correcciones del repositorio GitHub.
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- GARANTÍA DE BASE DE DATOS Y CONFIGURACIÓN -->
                    <div class="col-lg-5">
                        <div class="card shadow-sm h-100 border-primary">
                            <div class="card-header bg-primary text-white fw-bold">
                                <i class="fas fa-shield-halved me-2"></i>Protección de Base de Datos Local
                            </div>
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-start gap-3 mb-3">
                                        <div class="bg-primary-subtle text-primary p-2 rounded-circle fs-4">
                                            <i class="fas fa-database"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Cero Pérdida de Datos Garantizada</h6>
                                            <p class="small text-muted mb-0">
                                                Cada actualización realiza un <strong>respaldo previo automático</strong> de tus socios, compras, inventario, deudas y abonos antes de aplicar cualquier cambio de código.
                                            </p>
                                        </div>
                                    </div>

                                    <ul class="list-group list-group-flush small mb-3">
                                        <li class="d-flex justify-content-between py-1">
                                            <span>Socios registrados:</span>
                                            <strong class="text-dark"><%= totalClientes %> socios</strong>
                                        </li>
                                        <li class="d-flex justify-content-between py-1">
                                            <span>Transacciones de venta:</span>
                                            <strong class="text-dark"><%= totalVentas %> registradas</strong>
                                        </li>
                                        <li class="d-flex justify-content-between py-1">
                                            <span>Inventario preservado:</span>
                                            <strong class="text-dark"><%= totalProductos %> productos</strong>
                                        </li>
                                        <li class="d-flex justify-content-between py-1 border-top pt-2">
                                            <span>Puntos de restauración activos:</span>
                                            <span class="badge bg-secondary"><%= updater.puntosDeRestauracion.length %> respaldos</span>
                                        </li>
                                    </ul>
                                </div>

                                <form method="POST" action="/pages/actualizaciones.php" class="border-top pt-3">
                                    <input type="hidden" name="accion" value="simular_nueva_version">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100">
                                        <i class="fas fa-code-branch me-1"></i> Simular Disponibilidad de Nueva Versión
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- LANZADOR AUTÓNOMO Y ACTUALIZACIÓN EN iniciar_gimnasio.bat -->
                <div class="card shadow-sm mb-4 border-start border-4 border-primary">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary fs-6 px-3 py-2">
                                    <i class="fas fa-terminal me-1"></i> iniciar_gimnasio.bat
                                </span>
                                <h5 class="fw-bold mb-0 text-dark">Inicio Inteligente con Actualización y Auto-Reinicio</h5>
                            </div>
                            <div>
                                <% if (banderaBatActiva) { %>
                                    <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                                        <i class="fas fa-bolt me-1"></i> Simulación activa para el próximo lanzamiento
                                    </span>
                                <% } else { %>
                                    <span class="badge bg-success-subtle text-success fs-6 px-3 py-2">
                                        <i class="fas fa-check-circle me-1"></i> Comprobador activo en arranque
                                    </span>
                                <% } %>
                            </div>
                        </div>

                        <p class="text-secondary mb-3">
                            Al ejecutar <code>iniciar_gimnasio.bat</code> (en Windows) o <code>./iniciar_gimnasio.sh</code> (en Linux/macOS), el lanzador ejecuta automáticamente el ciclo completo:
                        </p>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded border h-100">
                                    <div class="fw-bold text-primary mb-1">
                                        <i class="fas fa-1 me-1 text-primary"></i> 1. Comprobación Inicial
                                    </div>
                                    <p class="small text-muted mb-0">
                                        Antes de arrancar la webapp, consulta la API de GitHub para verificar si existe un release o versión más reciente.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded border h-100">
                                    <div class="fw-bold text-success mb-1">
                                        <i class="fas fa-2 me-1 text-success"></i> 2. Descarga e Instalación Segura
                                    </div>
                                    <p class="small text-muted mb-0">
                                        Si hay nueva versión, la descarga e instala de inmediato. <strong>La base de datos local no se modifica</strong> y se crea un respaldo automático preventivo.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded border h-100">
                                    <div class="fw-bold text-info mb-1">
                                        <i class="fas fa-3 me-1 text-info"></i> 3. Auto-Relanzamiento
                                    </div>
                                    <p class="small text-muted mb-0">
                                        Al concluir la actualización, se vuelve a lanzar <code>iniciar_gimnasio.bat</code> automáticamente para empezar la webapp actualizada.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 align-items-center pt-2 border-top">
                            <% if (banderaBatActiva) { %>
                                <form method="POST" action="/pages/actualizaciones.php" class="m-0">
                                    <input type="hidden" name="accion" value="cancelar_simulacion_bat">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="fas fa-xmark me-1"></i> Desactivar Simulación
                                    </button>
                                </form>
                                <span class="small text-muted">
                                    Listo: La próxima vez que abras <code>iniciar_gimnasio.bat</code>, detectará la actualización, la instalará sin tocar tu base de datos y se relanzará.
                                </span>
                            <% } else { %>
                                <form method="POST" action="/pages/actualizaciones.php" class="m-0">
                                    <input type="hidden" name="accion" value="simular_para_bat">
                                    <button type="submit" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-play me-1"></i> Probar actualización en el próximo inicio de iniciar_gimnasio.bat
                                    </button>
                                </form>
                                <span class="small text-muted">
                                    Haz clic para forzar que el próximo lanzamiento de <code>iniciar_gimnasio.bat</code> ejecute el flujo de actualización y reinicio.
                                </span>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- HISTORIAL DE ACTUALIZACIONES INSTALADAS -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light fw-bold">
                        <i class="fas fa-timeline me-2"></i>Historial de Actualizaciones Realizadas
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Versión</th>
                                    <th>Fecha y Hora</th>
                                    <th>Origen</th>
                                    <th>Descripción de Cambios</th>
                                    <th>Base de Datos Local</th>
                                    <th class="text-end">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (historial.length === 0) { %>
                                    <tr><td colspan="6" class="text-center py-4 text-muted">No se registran actualizaciones pasadas.</td></tr>
                                <% } else { %>
                                    <% historial.forEach(function(h) { %>
                                    <tr>
                                        <td><span class="badge bg-dark font-monospace fs-6"><%= h.version %></span></td>
                                        <td><%= h.fecha %></td>
                                        <td>
                                            <i class="fab fa-github text-muted me-1"></i>
                                            <span class="small"><%= h.origen %></span>
                                        </td>
                                        <td class="fw-bold"><%= h.descripcion %></td>
                                        <td>
                                            <span class="badge bg-success-subtle text-success border border-success">
                                                <i class="fas fa-lock me-1"></i>Preservada y Segura
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <span class="badge bg-success">
                                                <i class="fas fa-check me-1"></i>Exitosa
                                            </span>
                                        </td>
                                    </tr>
                                    <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- PUNTOS DE RESTAURACIÓN DE SEGURIDAD -->
                <% if (updater.puntosDeRestauracion.length > 0) { %>
                <div class="card shadow-sm border-info">
                    <div class="card-header bg-info-subtle text-info-emphasis fw-bold">
                        <i class="fas fa-clock-rotate-left me-2"></i>Puntos de Restauración Automáticos Previos a Actualización
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr><th>Fecha de Creación</th><th>Etiqueta de Respaldo</th><th>Detalle de Datos Protegidos</th><th class="text-end">Acción</th></tr>
                                </thead>
                                <tbody>
                                    <% updater.puntosDeRestauracion.forEach(function(p, idx) { %>
                                    <tr>
                                        <td><%= p.fecha %></td>
                                        <td class="fw-bold"><%= p.etiqueta %></td>
                                        <td class="small text-muted"><%= p.resumen %></td>
                                        <td class="text-end">
                                            <form method="POST" action="/pages/actualizaciones.php" class="d-inline m-0" onsubmit="return confirm('¿Restaurar la base de datos a este punto previo?');">
                                                <input type="hidden" name="accion" value="restaurar_punto">
                                                <input type="hidden" name="indice" value="<%= idx %>">
                                                <button class="btn btn-sm btn-outline-info">
                                                    <i class="fas fa-undo me-1"></i> Restaurar Punto
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <% } %>
            </main>
        </div>
    </div>
    <script src="/js/bootstrap.bundle.min.js"></script>
</body>
</html>
