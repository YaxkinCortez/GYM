<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Estado del Sistema - Gimnasio La Fábrica</title>
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="container-fluid">
        <div class="row">
            <%- include('partials/sidebar') %>
            <main class="col-md-10 ms-sm-auto px-md-4 main-content">
                <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h1><i class="fas fa-shield-halved me-2"></i>Estado del Sistema</h1>
                        <p class="text-muted mb-0 small">Versión local instalada e historial de actualizaciones. El arranque es 100% local; GitHub solo se consulta cuando tú pulses el botón.</p>
                    </div>
                    <form method="POST" action="/pages/actualizaciones.php" class="m-0">
                        <input type="hidden" name="accion" value="comprobar_ahora">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                            <i class="fab fa-github me-2"></i>Buscar actualizaciones en GitHub
                        </button>
                    </form>
                </div>

                <% if (mensaje) { %>
                    <div class="alert alert-<%= tipo_mensaje %> alert-dismissible fade show shadow-sm">
                        <%- mensaje %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <!-- TARJETA PRINCIPAL DE ESTADO DE VERSIÓN -->
                <div class="row g-4 mb-4">
                    <div class="col-lg-7">
                        <div class="card shadow-sm h-100 border-top border-4 <%= updater.actualizacionDisponible ? 'border-warning' : 'border-success' %>">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <small class="text-muted text-uppercase fw-bold">Estado de la Versión Local</small>
                                        <% if (updater.actualizacionDisponible) { %>
                                        <h3 class="fw-bold my-1 text-warning"><i class="fas fa-arrow-up-circle me-1"></i>Nueva versión disponible: <%= updater.actualizacionDisponible.version %></h3>
                                        <p class="text-muted small mb-0">
                                            Tu versión local es <strong><%= updater.versionActual %></strong>. Se encontró una versión más reciente en GitHub.
                                            Al instalarla, tus datos se respaldan automáticamente y NO se modifica tu base de datos local.
                                        </p>
                                        <% } else { %>
                                        <h3 class="fw-bold my-1 text-dark">Sistema Operativo al Día</h3>
                                        <p class="text-muted small mb-0">
                                            El arranque del programa es 100% offline. Esta página solo consulta GitHub cuando tú pulsas el botón "Buscar actualizaciones".
                                        </p>
                                        <% } %>
                                    </div>
                                    <span class="badge <%= updater.actualizacionDisponible ? 'bg-warning text-dark' : 'bg-success' %> fs-6 px-3 py-2">
                                        <i class="fas fa-<%= updater.actualizacionDisponible ? 'cloud-arrow-down' : 'check-circle' %> me-1"></i>
                                        v<%= updater.versionActual %>
                                    </span>
                                </div>

                                <div class="row g-3 bg-light p-3 rounded border mb-3">
                                    <div class="col-sm-6">
                                        <div class="text-muted small">Versión Instalada:</div>
                                        <div class="fs-5 fw-bold text-primary"><%= updater.versionActual %></div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="text-muted small">Última Comprobación:</div>
                                        <div class="fw-bold text-dark"><%= updater.ultimaComprobacion %></div>
                                    </div>
                                </div>

                                <% if (updater.actualizacionDisponible) { %>
                                <div class="d-grid gap-2 mb-3">
                                    <form method="POST" action="/pages/actualizaciones.php" class="m-0" id="formInstalar">
                                        <input type="hidden" name="accion" value="instalar_actualizacion">
                                        <div class="card border shadow-sm bg-light">
                                            <div class="card-body py-3">
                                                <div class="fw-bold mb-2"><i class="fas fa-lock me-1 text-danger"></i>Confirmación de seguridad para instalar v<%= updater.actualizacionDisponible.version %></div>
                                                <div class="row g-2">
                                                    <div class="col-md-5">
                                                        <input type="text" name="confirmar_usuario" class="form-control" placeholder="Tu usuario" autocomplete="off" required>
                                                    </div>
                                                    <div class="col-md-5">
                                                        <input type="password" name="confirmar_password" class="form-control" placeholder="Tu contraseña" autocomplete="new-password" required>
                                                    </div>
                                                    <div class="col-md-2 d-grid">
                                                        <button type="submit" class="btn btn-success">
                                                            <i class="fas fa-download me-1"></i>Instalar
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="small text-muted mt-2">
                                                    <i class="fas fa-shield-halved me-1"></i>Se creará un respaldo automático ANTES de instalar. Tu base de datos local NO se modifica. Por seguridad, <b>se cerrará tu sesión</b> durante la instalación y deberás volver a iniciar sesión al terminar.
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                    <script>
                                    // v1.3.4: el boton de instalar ahora pide usuario y contrasena en la propia pagina
                                    document.getElementById('formInstalar').addEventListener('submit', function (e) {
                                        var u = this.querySelector('[name=confirmar_usuario]').value.trim();
                                        var p = this.querySelector('[name=confirmar_password]').value;
                                        if (!u || !p) {
                                            e.preventDefault();
                                            alert('Para instalar la actualización debes escribir tu usuario y contraseña de confirmación.');
                                            return false;
                                        }
                                        if (!confirm('¿Instalar la versión <%= updater.actualizacionDisponible.version %>? Se cerrará tu sesión actual y el sistema se reiniciará automáticamente. Tus socios, cobros, adeudos e inventario quedan intactos.')) {
                                            e.preventDefault();
                                            return false;
                                        }
                                    });
                                    </script>
                                </div>
                                <div class="alert alert-warning bg-warning-subtle text-warning-emphasis border-warning small mb-0">
                                    <i class="fas fa-circle-info me-2"></i>Origen: <%= updater.actualizacionDisponible.descripcion || 'GitHub main' %> (<%= updater.actualizacionDisponible.fecha || 'reciente' %>). La instalación cierra sesión y reinicia el sistema automáticamente al terminar; tus socios, cobros, adeudos e inventario quedan intactos.
                                </div>
                                <% } else { %>
                                <div class="alert alert-success bg-success-subtle text-success border-success small mb-0">
                                    <i class="fas fa-shield-check me-2"></i>Tu sistema cuenta con la versión más reciente instalada localmente (<%= updater.versionActual %>). No hay descargas pendientes.
                                </div>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- GARANTÍA DE BASE DE DATOS Y CONFIGURACIÓN -->
                    <div class="col-lg-5">
                        <div class="card shadow-sm h-100 border-primary">
                            <div class="card-header bg-primary text-white fw-bold">
                                <i class="fas fa-shield-halved me-2"></i>Protección de Base de Datos Local
                            </div>
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-start gap-3 mb-3">
                                        <div class="bg-primary-subtle text-primary p-2 rounded-circle fs-4">
                                            <i class="fas fa-database"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Cero Pérdida de Datos Garantizada</h6>
                                            <p class="small text-muted mb-0">
                                                Cada actualización realiza un <strong>respaldo previo automático</strong> de tus socios, compras, inventario, deudas y abonos antes de aplicar cualquier cambio de código.
                                            </p>
                                        </div>
                                    </div>

                                    <ul class="list-group list-group-flush small mb-3">
                                        <li class="d-flex justify-content-between py-1">
                                            <span>Socios registrados:</span>
                                            <strong class="text-dark"><%= totalClientes %> socios</strong>
                                        </li>
                                        <li class="d-flex justify-content-between py-1">
                                            <span>Transacciones de venta:</span>
                                            <strong class="text-dark"><%= totalVentas %> registradas</strong>
                                        </li>
                                        <li class="d-flex justify-content-between py-1">
                                            <span>Inventario preservado:</span>
                                            <strong class="text-dark"><%= totalProductos %> productos</strong>
                                        </li>
                                        <li class="d-flex justify-content-between py-1 border-top pt-2">
                                            <span>Puntos de restauración activos:</span>
                                            <span class="badge bg-secondary"><%= updater.puntosDeRestauracion.length %> respaldos</span>
                                        </li>
                                    </ul>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!-- MODO LOCAL -->
                <div class="card shadow-sm mb-4 border-start border-4 border-primary">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-primary fs-6 px-3 py-2"><i class="fas fa-terminal me-1"></i> iniciar_gimnasio.bat</span>
                            <h5 class="fw-bold mb-0 text-dark">Inicio 100% Local (Sin Descargas)</h5>
                        </div>
                        <p class="text-secondary mb-0">
                            Al ejecutar <code>iniciar_gimnasio.bat</code>, el sistema arranca directamente el servidor local y abre la aplicación.
                            No se consulta Internet ni se descargan paquetes: tus datos nunca se modifican durante el arranque.
                        </p>
                    </div>
                </div>

                <!-- HISTORIAL DE ACTUALIZACIONES INSTALADAS -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light fw-bold">
                        <i class="fas fa-timeline me-2"></i>Historial de Actualizaciones Realizadas
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Versión</th>
                                    <th>Fecha y Hora</th>
                                    <th>Origen</th>
                                    <th>Descripción de Cambios</th>
                                    <th>Base de Datos Local</th>
                                    <th class="text-end">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (historial.length === 0) { %>
                                    <tr><td colspan="6" class="text-center py-4 text-muted">No se registran actualizaciones pasadas.</td></tr>
                                <% } else { %>
                                    <% historial.forEach(function(h) { %>
                                    <tr>
                                        <td><span class="badge bg-dark font-monospace fs-6"><%= h.version %></span></td>
                                        <td><%= h.fecha %></td>
                                        <td>
                                            <span class="small"><%= h.origen %></span>
                                        </td>
                                        <td class="fw-bold"><%= h.descripcion %></td>
                                        <td>
                                            <span class="badge bg-success-subtle text-success border border-success">
                                                <i class="fas fa-lock me-1"></i>Preservada y Segura
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <span class="badge bg-success">
                                                <i class="fas fa-check me-1"></i>Exitosa
                                            </span>
                                        </td>
                                    </tr>
                                    <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- PUNTOS DE RESTAURACIÓN DE SEGURIDAD -->
                <% if (updater.puntosDeRestauracion.length > 0) { %>
                <div class="card shadow-sm border-info">
                    <div class="card-header bg-info-subtle text-info-emphasis fw-bold">
                        <i class="fas fa-clock-rotate-left me-2"></i>Puntos de Restauración Automáticos Previos a Actualización
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr><th>Fecha de Creación</th><th>Etiqueta de Respaldo</th><th>Detalle de Datos Protegidos</th><th class="text-end">Acción</th></tr>
                                </thead>
                                <tbody>
                                    <% updater.puntosDeRestauracion.forEach(function(p, idx) { %>
                                    <tr>
                                        <td><%= p.fecha %></td>
                                        <td class="fw-bold"><%= p.etiqueta %></td>
                                        <td class="small text-muted"><%= p.resumen %></td>
                                        <td class="text-end">
                                            <form method="POST" action="/pages/actualizaciones.php" class="d-inline m-0" onsubmit="return confirm('¿Restaurar la base de datos a este punto previo?');">
                                                <input type="hidden" name="accion" value="restaurar_punto">
                                                <input type="hidden" name="indice" value="<%= idx %>">
                                                <button class="btn btn-sm btn-outline-info">
                                                    <i class="fas fa-undo me-1"></i> Restaurar Punto
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <% } %>
            </main>
        </div>
    </div>
    <script src="/js/bootstrap.bundle.min.js"></script>
</body>
</html>
