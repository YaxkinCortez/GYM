<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editor de Tablas - Gimnasio La Fabrica</title>
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="container-fluid">
        <div class="row">
            <%- include('partials/sidebar') %>
            <main class="col-md-10 ms-sm-auto px-md-4 main-content">
                <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h1><i class="fas fa-table-list me-2"></i>Editor y Visor de Tablas</h1>
                        <p class="text-muted mb-0 small">Explorador directo de las entidades del modelo de datos</p>
                    </div>
                </div>

                <div class="card mb-4 shadow-sm">
                    <div class="card-body">
                        <form method="GET" action="/pages/tablas.php" class="row g-2 align-items-center">
                            <div class="col-md-8">
                                <label class="form-label small fw-bold">Seleccionar Tabla:</label>
                                <select name="tabla" class="form-select" onchange="this.form.submit()">
                                    <% listaTablas.forEach(function(t) { %>
                                        <option value="<%= t %>" <%= tablaSeleccionada === t ? 'selected' : '' %>><%= t %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100"><i class="fas fa-eye me-1"></i> Ver Datos</button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header bg-light fw-bold">
                        <i class="fas fa-database me-2"></i>Registros en "<%= tablaSeleccionada %>" (<%= filas.length %> registros)
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0 font-monospace">
                            <thead class="table-light">
                                <tr>
                                    <% if (filas.length > 0) { %>
                                        <% Object.keys(filas[0]).forEach(function(k) { %>
                                            <th><%= k %></th>
                                        <% }); %>
                                    <% } else { %>
                                        <th>Sin datos</th>
                                    <% } %>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (filas.length === 0) { %>
                                    <tr><td class="text-center py-4 text-muted">La tabla está vacía.</td></tr>
                                <% } else { %>
                                    <% filas.forEach(function(f) { %>
                                    <tr>
                                        <% Object.values(f).forEach(function(val) { %>
                                            <td><%= (val !== null && val !== undefined) ? val : '<nulo>' %></td>
                                        <% }); %>
                                    </tr>
                                    <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <script src="/js/bootstrap.bundle.min.js"></script>
</body>
</html>
